name: Block Release to Main Merge

on:
  pull_request:
    branches:
      - main
    types: [opened, edited, synchronized]

jobs:
  check-source-branch:
    runs-on: ubuntu-latest
    steps:
      - name: Check if source is release branch
        run: |
          if [[ "${{ github.head_ref }}" == "release" ]]; then
            echo "ERROR: You cannot merge the 'release' branch back into 'main'."
            exit 1
          fi
